---
import Button from "./Button.astro";

interface Props {
  variant?: "primary" | "secondary" | "ghost";
  size?: "sm" | "md" | "lg";
  class?: string;
  buttonClass?: string;
}

const {
  variant = "primary",
  size = "md",
  class: className = "",
  buttonClass = "",
} = Astro.props;
---

<span class:list={["inline-flex", className]}>
  <Button href="#demo" variant={variant} size={size} class={buttonClass} data-demo-cta>
    Request Demo
  </Button>
</span>
