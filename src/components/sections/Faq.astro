---
import SectionShell from "../ui/SectionShell.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import { faqItems, sectionCopy } from "../../data/site";
---

<SectionShell id="faq" variant="white">
  <SectionHeader
    eyebrow={sectionCopy.faq.eyebrow}
    title={sectionCopy.faq.title}
    description={sectionCopy.faq.intro}
  />

  <div class="mx-auto mt-10 max-w-3xl space-y-3 md:mt-14">
    {
      faqItems.map((item) => (
        <details class="group rounded-2xl border border-sv-border-light bg-steel/40 px-5 py-4 open:bg-white open:shadow-sm">
          <summary class="cursor-pointer list-none text-left text-base font-semibold text-navy marker:content-none [&::-webkit-details-marker]:hidden">
            <span class="flex items-start justify-between gap-4">
              <span>{item.question}</span>
              <span
                class="mt-0.5 inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-sv-blue/20 text-sv-blue transition-transform group-open:rotate-45"
                aria-hidden="true"
              >
                +
              </span>
            </span>
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-gray-text sm:text-base">{item.answer}</p>
        </details>
      ))
    }
  </div>
</SectionShell>
