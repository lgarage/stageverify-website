---
import SectionShell from "../ui/SectionShell.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import DemoCta from "../ui/DemoCta.astro";
import { sectionCopy } from "../../data/site";
---

<SectionShell id="demo" variant="navy" containerClass="text-center">
  <div class="mx-auto max-w-2xl">
    <SectionHeader
      eyebrow={sectionCopy.demo.eyebrow}
      title={sectionCopy.demo.title}
      description={sectionCopy.demo.intro}
      dark
    />

    <div class="mt-12 flex flex-col items-center gap-3 md:mt-14">
      <DemoCta
        variant="primary"
        size="lg"
        buttonClass="min-w-[220px] shadow-lg shadow-sv-blue/25"
      />
      <p class="text-xs text-white/50">{sectionCopy.demo.reassurance}</p>
    </div>
  </div>
</SectionShell>
