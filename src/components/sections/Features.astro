---
import SectionShell from "../ui/SectionShell.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import { primaryCapabilities, secondaryCapabilities, sectionCopy } from "../../data/site";
---

<SectionShell id="features" variant="navy" class="!py-12 md:!py-16">
  <SectionHeader
    eyebrow={sectionCopy.features.eyebrow}
    title={sectionCopy.features.title}
    dark
  />

  <ul class="mt-7 grid gap-3 sm:grid-cols-2 md:mt-9">
    {
      primaryCapabilities.map((feature) => (
        <li
          class="flex gap-3 rounded-lg border border-white/10 bg-white/[0.04] px-4 py-3"
          data-primary-capability
        >
          <span
            class="mt-0.5 inline-flex h-4 w-4 shrink-0 items-center justify-center text-sv-cyan"
            aria-hidden="true"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
          </span>
          <div>
            <h3 class="text-sm font-semibold leading-snug text-white">{feature.title}</h3>
            <p class="mt-1 text-sm leading-snug text-white/65">{feature.description}</p>
          </div>
        </li>
      ))
    }
  </ul>

  <div class="mt-8 border-t border-white/10 pt-6 md:mt-10">
    <h3 class="text-sm font-semibold uppercase tracking-wide text-white/70">Also includes</h3>
    <ul class="mt-3 space-y-2">
      {
        secondaryCapabilities.map((item) => (
          <li class="flex gap-2 text-sm leading-relaxed text-white/55">
            <span class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-sv-cyan/60" aria-hidden="true" />
            <span>{item}</span>
          </li>
        ))
      }
    </ul>
  </div>
</SectionShell>
