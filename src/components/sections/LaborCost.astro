---
import SectionShell from "../ui/SectionShell.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import { laborExclusions, sectionCopy } from "../../data/site";
---

<SectionShell id="labor-cost" variant="steel" class="!py-12 md:!py-16">
  <SectionHeader
    eyebrow={sectionCopy.laborCost.eyebrow}
    title={sectionCopy.laborCost.title}
  />

  <div class="mx-auto mt-7 max-w-2xl space-y-4 md:mt-9">
    <p class="text-center text-sm leading-relaxed text-gray-text sm:text-base">
      {sectionCopy.laborCost.receivingCost}
    </p>
    <p class="text-center text-sm leading-relaxed text-gray-text sm:text-base">
      {sectionCopy.laborCost.productScope}
    </p>
    <p class="text-center text-sm leading-relaxed text-gray-text sm:text-base">
      {sectionCopy.laborCost.calculatorLeadIn}
    </p>

    <div class="mt-5 rounded-xl border border-sv-border-light bg-white px-4 py-4 shadow-sm sm:px-5">
      <p class="text-xs font-semibold tracking-wide text-navy">Not included in this estimate:</p>
      <ul class="mt-2 grid gap-1.5 text-sm text-gray-text sm:grid-cols-2">
        {
          laborExclusions.map((item) => (
            <li class="flex gap-2">
              <span class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-sv-blue/50" aria-hidden="true" />
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</SectionShell>
