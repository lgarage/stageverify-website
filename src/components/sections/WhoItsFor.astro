---
import SectionShell from "../ui/SectionShell.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import { qualificationSignals, sectionCopy } from "../../data/site";
---

<SectionShell id="who-its-for" variant="white" class="!py-12 md:!py-16">
  <SectionHeader
    eyebrow={sectionCopy.whoItsFor.eyebrow}
    title={sectionCopy.whoItsFor.title}
    description={sectionCopy.whoItsFor.intro}
  />

  <p class="mt-7 text-center text-sm leading-relaxed text-gray-text md:mt-9">
    {sectionCopy.whoItsFor.secondary}
  </p>

  <div class="mt-7 md:mt-9">
    <h3 class="text-base font-semibold text-navy sm:text-lg">
      {sectionCopy.qualification.title}
    </h3>
    <ul class="mt-4 grid gap-2 sm:grid-cols-2">
      {
        qualificationSignals.map((signal) => (
          <li class="flex gap-2 text-sm leading-relaxed text-gray-text">
            <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-sv-blue/60" aria-hidden="true" />
            <span>{signal}</span>
          </li>
        ))
      }
    </ul>
    <p class="mt-5 text-sm leading-relaxed text-gray-text">
      {sectionCopy.qualification.customerFit}
    </p>
  </div>
</SectionShell>
