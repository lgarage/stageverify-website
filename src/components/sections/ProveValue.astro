---
import SectionShell from "../ui/SectionShell.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import { managementPreview, sectionCopy } from "../../data/site";

const { lineChart, barChart } = managementPreview;
const chartWidth = 320;
const chartHeight = 160;
const chartPadding = { top: 16, right: 12, bottom: 28, left: 36 };
const plotWidth = chartWidth - chartPadding.left - chartPadding.right;
const plotHeight = chartHeight - chartPadding.top - chartPadding.bottom;

const values = lineChart.data.map((point) => point.value);
const minValue = Math.min(...values);
const maxValue = Math.max(...values);
const valueRange = maxValue - minValue || 1;

const points = lineChart.data.map((point, index) => {
  const x =
    chartPadding.left +
    (index / Math.max(lineChart.data.length - 1, 1)) * plotWidth;
  const y =
    chartPadding.top +
    plotHeight -
    ((point.value - minValue) / valueRange) * plotHeight;
  return { ...point, x, y };
});

const linePath = points
  .map((point, index) => `${index === 0 ? "M" : "L"} ${point.x} ${point.y}`)
  .join(" ");

const areaPath = `${linePath} L ${points[points.length - 1].x} ${chartPadding.top + plotHeight} L ${points[0].x} ${chartPadding.top + plotHeight} Z`;

const barMax = Math.max(...barChart.data.map((item) => item.value));
---

<SectionShell id="prove-value" variant="steel" class="!py-12 md:!py-16">
  <SectionHeader
    eyebrow={sectionCopy.proveValue.eyebrow}
    title={sectionCopy.proveValue.title}
    description={sectionCopy.proveValue.intro}
  />

  <div
    class="mx-auto mt-7 max-w-5xl rounded-xl border border-sv-border-light bg-white shadow-sm md:mt-9"
    data-management-preview
  >
    <div class="flex flex-col gap-2 border-b border-sv-border-light bg-steel/40 px-4 py-3 sm:flex-row sm:items-center sm:justify-between sm:px-5">
      <p class="text-xs font-semibold uppercase tracking-wider text-sv-blue">
        {managementPreview.labels.illustrative}
      </p>
      <p class="text-sm font-semibold text-navy">
        {managementPreview.labels.snapshot}
      </p>
    </div>

    <div class="grid gap-3 p-4 sm:grid-cols-2 sm:p-5 lg:grid-cols-4">
      {
        managementPreview.summaryMetrics.map((metric) => (
          <div
            class="rounded-xl border border-sv-border-light bg-steel/30 px-4 py-3"
            data-example-metric
          >
            <p class="text-2xl font-bold tabular-nums text-navy">{metric.value}</p>
            <p class="mt-1 text-sm font-medium leading-snug text-navy">{metric.label}</p>
            {"supportingText" in metric && metric.supportingText ? (
              <p class="mt-1 text-xs text-gray-muted">{metric.supportingText}</p>
            ) : null}
          </div>
        ))
      }
    </div>

    <div class="grid gap-4 border-t border-sv-border-light p-4 sm:p-5 lg:grid-cols-2">
      <div class="rounded-xl border border-sv-border-light bg-steel/20 p-4" data-line-chart>
        <h3 class="text-sm font-semibold text-navy">{lineChart.title}</h3>
        <svg
          class="mt-3 w-full"
          viewBox={`0 0 ${chartWidth} ${chartHeight}`}
          role="img"
          aria-label={`${lineChart.title}: ${lineChart.data.map((point) => `${point.month} ${point.value} hours`).join(", ")}`}
        >
          <title>{lineChart.title}</title>
          <desc>
            Line chart showing example paid hours spent receiving and hunting parts declining from {lineChart.data[0].value} hours in {lineChart.data[0].month} to {lineChart.data[lineChart.data.length - 1].value} hours in {lineChart.data[lineChart.data.length - 1].month}.
          </desc>
          {
            [0, 0.5, 1].map((fraction) => {
              const y = chartPadding.top + plotHeight * (1 - fraction);
              return (
                <line
                  x1={chartPadding.left}
                  y1={y}
                  x2={chartPadding.left + plotWidth}
                  y2={y}
                  stroke="currentColor"
                  class="text-sv-border-light"
                  stroke-width="1"
                />
              );
            })
          }
          <path d={areaPath} class="fill-sv-cyan/15" />
          <path
            d={linePath}
            fill="none"
            class="stroke-sv-blue"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          {
            points.map((point) => (
              <>
                <circle cx={point.x} cy={point.y} r="3.5" class="fill-sv-blue" />
                <text
                  x={point.x}
                  y={chartHeight - 6}
                  text-anchor="middle"
                  class="fill-gray-text text-[9px]"
                >
                  {point.month}
                </text>
                <text
                  x={point.x}
                  y={point.y - 8}
                  text-anchor="middle"
                  class="fill-navy text-[9px] font-semibold"
                >
                  {point.value}
                </text>
              </>
            ))
          }
        </svg>
      </div>

      <div class="rounded-xl border border-sv-border-light bg-steel/20 p-4" data-bar-chart>
        <h3 class="text-sm font-semibold text-navy">{barChart.title}</h3>
        <ul class="mt-4 space-y-3">
          {
            barChart.data.map((item) => (
              <li>
                <div class="flex items-center justify-between gap-3 text-sm">
                  <span class="text-gray-text">{item.category}</span>
                  <span class="shrink-0 font-semibold tabular-nums text-navy">{item.value}</span>
                </div>
                <div class="mt-1.5 h-2 overflow-hidden rounded-full bg-steel">
                  <div
                    class="h-full rounded-full bg-sv-blue"
                    style={`width: ${(item.value / barMax) * 100}%`}
                  />
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <p class="border-t border-sv-border-light px-4 py-3 text-xs leading-relaxed text-gray-muted sm:px-5">
      {managementPreview.previewNote}
    </p>
  </div>
</SectionShell>
