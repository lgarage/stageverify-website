---
import SectionShell from "../ui/SectionShell.astro";
import SectionHeader from "../ui/SectionHeader.astro";
import { pricingIncludes, sectionCopy } from "../../data/site";
---

<SectionShell id="pricing" variant="navy" class="!py-12 md:!py-16">
  <SectionHeader
    title={sectionCopy.pricing.title}
    dark
  />

  <div class="mx-auto mt-7 max-w-md rounded-xl border border-white/10 bg-white/[0.04] p-5 sm:p-6 md:mt-9">
    <p class="text-center text-xs font-semibold uppercase tracking-widest text-sv-cyan">
      {sectionCopy.pricing.availability}
    </p>
    <p class="mt-3 text-center text-lg font-semibold text-white sm:text-xl">
      {sectionCopy.pricing.foundingPrice}{sectionCopy.pricing.foundingPeriod}
    </p>
    <p class="mt-4 text-center text-sm text-white/65">
      {sectionCopy.pricing.standardLabel}: {sectionCopy.pricing.standardPrice}{sectionCopy.pricing.standardPeriod}
    </p>

    <ul class="mt-5 space-y-2 border-t border-white/10 pt-4">
      {
        pricingIncludes.map((item) => (
          <li class="flex items-start gap-2.5 text-sm text-white/80">
            <span class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-sv-cyan" aria-hidden="true" />
            <span>{item}</span>
          </li>
        ))
      }
    </ul>
  </div>
</SectionShell>
