---
import Logo from "../ui/Logo.astro";
import DemoCta from "../ui/DemoCta.astro";
import { navLinks } from "../../data/site";
---

<header
  class="fixed inset-x-0 top-0 z-50 border-b border-white/10 bg-navy/90 backdrop-blur-md"
>
  <div class="mx-auto flex h-[60px] max-w-6xl items-center justify-between gap-2 px-4 sm:h-auto sm:gap-4 sm:px-6 sm:py-4 md:min-h-[64px] lg:px-8">
    <Logo size="header" />

    <nav class="hidden items-center gap-8 md:flex" aria-label="Main navigation">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="text-sm font-medium text-white/80 transition-colors hover:text-white"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden shrink-0 sm:block">
      <DemoCta variant="primary" size="sm" />
    </div>

    <details class="relative shrink-0 md:hidden">
      <summary
        class="flex h-10 w-10 cursor-pointer list-none items-center justify-center rounded-lg border border-white/20 text-white [&::-webkit-details-marker]:hidden"
        aria-label="Open menu"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </summary>
      <div
        class="absolute right-0 z-50 mt-2 w-56 max-w-[calc(100vw-2rem)] rounded-xl border border-white/10 bg-navy-light p-3 shadow-xl"
      >
          <nav class="flex flex-col gap-1" aria-label="Mobile navigation">
            {
              navLinks.map((link) => (
                <a
                  href={link.href}
                  class="rounded-lg px-3 py-2 text-sm font-medium text-white/90 hover:bg-white/10"
                >
                  {link.label}
                </a>
              ))
            }
            <div class="mt-2">
              <a
                href="#demo"
                data-demo-cta
                class="block rounded-lg bg-sv-blue px-3 py-2 text-center text-sm font-semibold text-white"
              >
                Request Demo
              </a>
            </div>
          </nav>
        </div>
    </details>
  </div>
  <script is:inline>
    document.querySelectorAll("header details nav a").forEach(function (link) {
      link.addEventListener("click", function () {
        var menu = link.closest("details");
        if (menu) menu.removeAttribute("open");
      });
    });
  </script>
</header>
